@page
@model Praja.Web.Pages.Work.IndexModel
@{ViewData["Title"]=Model.Heading;}
<div class="page-heading"><div><span class="eyebrow">@Model.Role.Role WORKSPACE</span><h1>@Model.Heading</h1><p>@Model.Description</p></div>@if(Model.Role.Role=="Admin"){<a class="button secondary" href="/Work/Team">Manage officers</a>}</div>
<nav class="role-dashboard-summary" aria-label="Case queues">
@foreach(var filter in Model.Filters){<a class="panel dashboard-count @(Model.Filter==filter?"selected":"")" asp-page="/Work/Index" asp-route-filter="@filter" aria-current="@(Model.Filter==filter?"page":null)"><strong data-count="@filter">@Model.Counts[filter]</strong><span>@Praja.Web.Pages.Work.IndexModel.Label(filter)</span></a>}
</nav>
<div class="dashboard-actions"><a class="button secondary" href="/Work/Notifications">Notifications · @Model.Escalations open cases with unread escalations</a>@if(Model.Role.Role is "Admin" or "Intake"){<a class="button secondary" href="/Automation">Review automated intake</a><a class="button secondary" href="/Intake">Intake inbox</a>}</div>
@if(Model.Role.Role=="Admin"){
<section class="panel form-panel"><h2>Department workload</h2><p>Open registered cases across the workspace, including demo samples.</p><div class="dashboard-departments">@foreach(var department in Model.Departments){<p><strong>@CaseRules.Departments.GetValueOrDefault(department.Department,department.Department)</strong> · @department.Open open</p>}@if(Model.Departments.Count==0){<p>No open cases.</p>}</div></section>}
<section class="panel form-panel"><h2>@Praja.Web.Pages.Work.IndexModel.Label(Model.Filter!) <span class="muted">(@Model.Total)</span></h2><p>Earliest target dates first. Counts include all matching cases, including demo samples. Dates use UTC.</p>
@foreach(var item in Model.Cases){var work=Model.Work.GetValueOrDefault(item.Id);<article class="workflow-card"><span class="case-reference">@item.Reference @(item.IsSample?"· Demo sample":"")</span><h3><a href="/Work/Case/@item.Id">@item.Title</a></h3><p>@CaseRules.Departments.GetValueOrDefault(item.Department,item.Department) · @CaseRules.WorkflowLabel(work?.Stage ?? item.Status)</p>@if(work is not null){<p>Target: @work.DueUtc.ToString("dd MMM yyyy") @(work.Stage!="Closed"&&work.DueUtc.Date<DateTime.UtcNow.Date?"· Overdue":"")</p>}else if(item.Status!="Closed"){<p>Awaiting assignment to a department officer.</p>}<a class="button secondary" href="/Work/Case/@item.Id">@(work is null?"Review and assign":Model.Role.Role=="Reviewer"&&work.Stage=="Verification"?"Inspect completion evidence":"Open case")</a></article>}
@if(Model.Cases.Count==0){<p>No cases in this queue. Choose another queue above to see other stages.</p>}
<nav class="dashboard-actions" aria-label="Queue pages">@if(Model.PageNumber>1){<a class="button secondary" asp-route-filter="@Model.Filter" asp-route-pageNumber="@(Model.PageNumber-1)">Previous</a>}<span>Page @Model.PageNumber of @Model.Pages</span>@if(Model.PageNumber<Model.Pages){<a class="button secondary" asp-route-filter="@Model.Filter" asp-route-pageNumber="@(Model.PageNumber+1)">Next</a>}</nav></section>
