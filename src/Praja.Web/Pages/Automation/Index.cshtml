@page "/Automation"
@model Praja.Web.Pages.Automation.IndexModel
@{ViewData["Title"]="Automatic intake";}
<div class="page-heading"><div><span class="eyebrow">AUTOMATIC INTAKE</span><h1>Complaints prepared for review.</h1><p class="muted">Collect, detect, extract and draft automatically. Review once before registration.</p></div><span class="badge @(Model.State.Enabled?"closed":"draft")">@(Model.State.Enabled?"Running":"Paused")</span></div>
@if(Model.Notice is not null){<p class="notice" role="status">@Model.Notice</p>}
<section class="panel form-panel"><h2>Gmail Inbox automation</h2><p><strong>Mailbox:</strong> @Model.Mailbox · @(Model.Connected?"Connected":"Connect Gmail first")</p><p>Inspects Inbox emails without applying a Gmail label. Local complaint rules discard unrelated messages from the preparation queue. Likely complaints are retained and sent to the configured AI service for extraction and drafting. Review uncertain matches; this detector can miss complaints. No emails are sent or changed.</p><p class="field-help">Checks every 60 seconds while this app is running. Each run considers up to 100 Inbox IDs, reads up to 20 unseen supported text emails and prepares up to 5 pending drafts. HTML bodies are converted to text. Up to three UTF-8 .txt or text-PDF attachments, 64 KiB each, are extracted locally. Combined text must fit 6,000 characters. Unsupported files exclude the whole email; review those in Gmail. Attachment binaries are not retained.</p>
@if(!Model.State.Enabled){<form method="post" asp-page-handler="Enable"><label class="check-row consent"><input asp-for="Permission" required/><span>I authorise automatic read-only Inbox collection, local retention of likely complaints and processing of those complaints by the configured AI service.</span></label><button class="button primary">Enable automatic intake</button></form>}else{<div class="form-actions"><form method="post" asp-page-handler="Run" data-busy><button class="button primary">Run now</button></form><form method="post" asp-page-handler="Pause"><button class="button secondary">Pause automation</button></form></div>}
<p><a class="text-link" href="/GmailSettings">Gmail connection settings</a></p><p><strong>Last run:</strong> @(Model.State.LastRunUtc?.ToString("dd MMM yyyy HH:mm 'UTC'")??"Not run")</p><p role="status">@Model.State.Status</p></section>
@if(Model.State.ManualReview.Any(r=>r.Mailbox==Model.Mailbox)){
<section class="panel form-panel"><h2>Emails needing manual review</h2><p>Latest 50 references retained across mailboxes. These emails were unsupported, oversized or moved out of the Inbox. No partial complaint was imported. Review in Gmail and capture a reviewed transcript in Intake inbox, or use labelled Gmail preview. Previously skipped messages are not automatically retried.</p><ul>
@foreach(var mail in Model.State.ManualReview.Where(r=>r.Mailbox==Model.Mailbox)){
<li><a href="@("https://mail.google.com/mail/?authuser="+Uri.EscapeDataString(mail.Mailbox)+"#all/"+Uri.EscapeDataString(mail.MessageId))" target="_blank" rel="noopener noreferrer">Review Gmail message @mail.MessageId</a></li>
}</ul></section>}
<section class="panel form-panel"><span class="eyebrow">ONE REVIEW STEP</span><h2>@Model.Queue.Count prepared complaints</h2><p class="muted">Extracted source text and Gmail references remain intact. Missing facts and uncertain routes are flagged rather than invented.</p>
@if(Model.Queue.Count==0){<p>No prepared complaints yet. Enable intake or run the social demo below.</p>}
@foreach(var row in Model.Queue){var p=row.Proposal;var a=p.Analysis;var missing=a.District.Length<2||a.Location.Length<2||a.Route.Department=="review";<article class="import-message"><div class="panel-heading"><h3>@p.Draft.Title</h3><span class="badge draft">@(missing?"Needs details":"Ready for review")</span></div><p>@p.Source @(p.IsDemo?"· Fictional demo":"")</p><p>@CaseRules.Departments[a.Route.Department] · @PilotRoutingCatalog.CategoryLabel(a.Route.Category) · @PilotRoutingCatalog.IssueLabel(a.Route.Subcategory)</p><p>District: @(a.District.Length>0?a.District:"Missing") · Location: @(a.Location.Length>0?a.Location:"Missing")</p><p class="field-help">@p.Draft.Method</p><a class="button primary" href="/Automation/Review/@p.InboxId">Review prepared complaint</a></article>}
</section>
<section class="panel form-panel"><span class="eyebrow">SOCIAL MONITORING PROTOTYPE</span><h2>X, Facebook and Instagram</h2><p><strong>Live collection is not connected.</strong> Platform API access is still required. This demo delivers three fictional posts through the collection, extraction and draft-preparation queue. It never logs in to or crawls a social platform.</p><form method="post" asp-page-handler="Demo" data-busy><label class="check-row consent"><input asp-for="Permission" required/><span>Process the three fictional social posts using the configured AI service when available.</span></label><button class="button secondary">Run social feed demo</button></form><p class="field-help">Repeated runs reuse source IDs. Demo cases are marked Sample after approval and excluded from normal analytics by default.</p></section>
