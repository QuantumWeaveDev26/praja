@page "{id:guid}"
@model Praja.Web.Pages.Automation.ReviewModel
@{ViewData["Title"]="Review prepared complaint";}
<a class="back-link" href="/Automation">← Automation queue</a><div class="page-heading"><div><span class="eyebrow">AUTOMATICALLY PREPARED · FINAL REVIEW</span><h1>Check once. Approve the complaint.</h1><p class="muted">@Model.Proposal.Source · @Model.Proposal.Draft.Method</p></div></div>
@if(Model.Proposal.IsDemo){<p class="notice"><strong>Fictional social-feed demonstration.</strong> No social platform was contacted. Approval marks this case as Sample.</p>}
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if(Model.Duplicates.Count>0){<section class="panel form-panel"><h2>Possible duplicate complaints</h2><p>Compare these records before registration. An officer can link this message to an existing case or record why it should remain separate.</p><ul class="plain-list">@foreach(var match in Model.Duplicates){<li><a class="text-link" href="@(match.IsCase?"/Grievances/Details/":"/Intake/Details/")@match.Id">@match.Label →</a><p class="field-help">@match.Reason</p></li>}</ul><a class="button secondary" href="/Intake/Details/@Model.Item.Id">Review possible duplicates</a></section>}
<div class="intake-grid"><section class="panel form-panel"><h2>Prepared details</h2><p>Correct only what needs attention. Empty district, location or service requires a check; nothing is guessed.</p><form method="post" asp-page-handler="Approve" data-busy><input asp-for="Version" type="hidden"/>
<label asp-for="Title">Complaint title</label><input asp-for="Title" required minlength="5" maxlength="160"/>
<div class="form-grid"><div><label asp-for="District">District</label><input asp-for="District" required minlength="2" maxlength="100"/></div><div><label asp-for="Location">Ward / locality / village</label><input asp-for="Location" required minlength="2" maxlength="200"/></div></div>
<label asp-for="Department">Suggested service</label><select asp-for="Department" required>@foreach(var service in CaseRules.Departments){<option value="@service.Key">@service.Value</option>}</select>
<div class="form-grid" data-routing-choices><div><label asp-for="CategoryCode">Demo category</label><select asp-for="CategoryCode"><option value="">Not classified</option>@foreach(var c in PilotRoutingCatalog.Categories){<option value="@c.Key" data-department="@c.Department" data-label="@c.Label">@c.Label</option>}</select></div><div><label asp-for="SubcategoryCode">Demo issue / subcategory</label><select asp-for="SubcategoryCode"><option value="">Not classified</option>@foreach(var i in PilotRoutingCatalog.Issues){<option value="@i.Key" data-category="@i.Category" data-label="@i.Label">@i.Label</option>}</select></div></div><p id="routing-choice-state" class="field-help" role="status"></p>
<label asp-for="DraftText">Prepared complaint draft</label><textarea asp-for="DraftText" rows="9" required minlength="20" maxlength="8000"></textarea>
<p class="field-help">Extraction: @Model.Proposal.Analysis.Method. Source excerpt: @(Model.Proposal.Analysis.Route.Evidence.Length>0?Model.Proposal.Analysis.Route.Evidence:"No single routing excerpt")</p>
<label class="check-row consent"><input asp-for="Reviewed" required/><span>I checked the original, prepared details and route, and approve local registration.</span></label><button class="button primary">Approve and register</button></form></section>
<aside><section class="panel form-panel"><h2>Preserved original</h2><blockquote class="original-text">@Model.Item.OriginalText</blockquote><p><a class="text-link" href="/Intake/Details/@Model.Item.Id">Source details and duplicate checks</a></p><p class="field-help">The source is preserved separately. No government portal submission or automatic resolution occurs.</p></section></aside></div>
