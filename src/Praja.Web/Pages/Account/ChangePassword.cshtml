@page
@model Praja.Web.Pages.Account.ChangePasswordModel
@{Layout=null;}
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Set your password · Praja</title><link rel="stylesheet" href="/css/site.css"/></head><body>
<main class="panel form-panel"><h1>Set your own password</h1><p>Your administrator supplied a temporary password. Replace it before you access complaints or officer tools.</p>
<div asp-validation-summary="All" class="validation" role="alert"></div>
<form method="post">
<label for="current">Current temporary password</label><input id="current" name="CurrentPassword" type="password" autocomplete="current-password" required maxlength="128"/>
<label for="new-password">New password (14–128 characters)</label><input id="new-password" name="NewPassword" type="password" autocomplete="new-password" required minlength="14" maxlength="128"/>
<label for="confirm-password">Confirm new password</label><input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="14" maxlength="128"/>
<p>Use a long, unique password. Other sessions will be signed out after the change.</p><button class="button primary">Save password and continue</button></form>
<form method="post" asp-page="/Account/Logout"><button class="button secondary">Sign out</button></form>
</main></body></html>
