@page "/Grievances"
@model Praja.Web.Pages.Grievances.IndexModel
@{ ViewData["Title"] = "Casework"; }
<div class="page-heading"><div><span class="eyebrow">THE OFFICER WORKSPACE</span><h1>From concern to follow-through.</h1><p class="muted">Find a case, review its context and move the work forward.</p></div><a class="button primary" href="/Grievances/New">＋ Register a grievance</a></div>
<section class="panel"><form method="get" class="filters"><div class="search-field"><label asp-for="Query" class="sr-only">Search cases</label><input asp-for="Query" placeholder="Search by concern, reference or district…" maxlength="200" /></div><div><label asp-for="Status" class="sr-only">Status</label><select asp-for="Status"><option value="">All statuses</option>@foreach (var status in CaseRules.Statuses) { <option value="@status">@CaseRules.StatusLabel(status)</option> }</select></div><div><label asp-for="Department" class="sr-only">Service</label><select asp-for="Department"><option value="">All services</option>@foreach (var dept in CaseRules.Departments) { <option value="@dept.Key">@dept.Value</option> }</select></div><button class="button secondary" type="submit">Filter</button>@if (Model.Query != null || Model.Status != null || Model.Department != null) { <a class="text-link" href="/Grievances">Clear</a> }</form>
<div class="panel-heading compact"><span class="muted small">@Model.Cases.Count results · Showing up to 200 cases</span><span class="small muted">Local workspace records</span></div>
@if (!Model.Cases.Any()) { <div class="empty-state"><span>◇</span><h3>No cases match this view.</h3><p>Try another search or register a new grievance.</p><a class="button secondary" href="/Grievances">Reset filters</a></div> }
else { <div class="table-wrap"><table><thead><tr><th>Grievance</th><th>Service</th><th>District / channel</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>@foreach (var item in Model.Cases) { <tr><td><a class="case-title" href="/Grievances/Details/@item.Id">@item.Title</a><span class="case-reference">@item.Reference @if (item.IsSample) { <span class="sample-label">Sample</span> }</span></td><td class="cell-muted">@CaseRules.Departments[item.Department]</td><td class="cell-muted">@item.District<span class="case-reference">@item.Source</span></td><td><span class="badge @item.Status.ToLowerInvariant()">@CaseRules.StatusLabel(item.Status)</span></td><td class="cell-muted small">@item.UpdatedUtc.ToString("dd MMM yyyy")<span class="case-reference">UTC</span></td><td><a class="row-arrow" href="/Grievances/Details/@item.Id" aria-label="Open @item.Reference">↗</a></td></tr> }</tbody></table></div> }
</section>
