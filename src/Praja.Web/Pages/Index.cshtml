@page
@model IndexModel
@{ ViewData["Title"] = "Overview"; }
<div class="page-heading"><div><span class="eyebrow">OFFICER WORKSPACE</span><h1>Manage complaints.</h1><p class="muted">Capture complaints, review drafts and follow up on resolution.</p></div><a class="button primary" href="/Grievances/New">＋ New complaint</a></div>
<section class="quick-actions" aria-label="Choose your next task">
    <a href="/Grievances/New"><span class="eyebrow">CAPTURE</span><h2>New complaint</h2><p>Type, record a voice or upload a petition. Review before registration.</p><strong>Start a complaint</strong></a>
    <a href="/Intake"><span class="eyebrow">REVIEW</span><h2>Incoming messages</h2><p>Review saved channel sources and matching complaints before creating a case.</p><strong>Open intake inbox</strong></a>
    <a href="/Citizen"><span class="eyebrow">FOLLOW UP</span><h2>Citizen guidance and status</h2><p>Find service guidance or check a local case using its private access code.</p><strong>Open citizen assistance</strong></a>
</section>
<p class="demo-explainer">Independent prototype. Cases stay in this workspace; no government submission or automatic social media collection.</p>
@if (Model.Cases.Any(c => c.IsSample)) { <div class="notice sample-notice"><span class="notice-icon">◈</span><div><strong>You’re exploring a pilot workspace.</strong> Cases marked “Sample” are fictional. Dashboard counts include them.</div><a href="/Readiness">View connections →</a></div> }
<section class="metric-grid" aria-label="Case counts">
    <article class="metric"><div><span>Active grievances</span><span class="metric-symbol">▤</span></div><strong>@Model.Active.ToString("D2")</strong><p>All cases awaiting closure</p></article>
    <article class="metric"><div><span>Drafts to confirm</span><span class="metric-symbol amber">✎</span></div><strong>@Model.Drafts.ToString("D2")</strong><p>Review the draft and routing</p></article>
    <article class="metric"><div><span>Closure reviews</span><span class="metric-symbol blue">◇</span></div><strong>@Model.Reviews.ToString("D2")</strong><p>Evidence and citizen feedback</p></article>
    <article class="metric"><div><span>Closed locally</span><span class="metric-symbol green">✓</span></div><strong>@Model.Closed.ToString("D2")</strong><p>Confirmed by the handling officer</p></article>
</section>
<div class="overview-grid"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">RECENT CASEWORK</span><h2>Recent grievances</h2></div><a class="text-link" href="/Grievances">View all →</a></div>
@if (!Model.Cases.Any()) { <div class="empty-state"><span>＋</span><h3>Your first case starts here.</h3><p>Record a citizen’s concern and prepare it for officer review.</p><a class="button primary" href="/Grievances/New">Register a grievance</a></div> }
else { <div class="table-wrap"><table><thead><tr><th>Grievance</th><th>District</th><th>Status</th><th><span class="sr-only">Open</span></th></tr></thead><tbody>@foreach (var item in Model.Cases.Take(6)) { <tr><td><a class="case-title" href="/Grievances/Details/@item.Id">@item.Title</a><span class="case-reference">@item.Reference @if (item.IsSample) { <span class="sample-label">Sample</span> }</span></td><td class="cell-muted">@item.District</td><td><span class="badge @item.Status.ToLowerInvariant()">@CaseRules.StatusLabel(item.Status)</span></td><td><a class="row-arrow" href="/Grievances/Details/@item.Id" aria-label="Open @item.Reference">↗</a></td></tr> }</tbody></table></div> }
</section><aside class="panel next-steps"><span class="eyebrow">OFFICER REVIEW</span><h2>Review tasks</h2><a class="focus-item" href="/Grievances?Status=Draft"><span class="focus-number">@Model.Drafts</span><div><strong>Confirm the complaint</strong><p>Preserve the citizen’s meaning.</p></div><span>→</span></a><a class="focus-item" href="/Grievances?Status=ClosureReview"><span class="focus-number">@Model.Reviews</span><div><strong>Review the resolution</strong><p>Check evidence and feedback.</p></div><span>→</span></a><div class="review-note"><span>◇</span><p>A completed checklist supports your review. It cannot prove that a physical issue has been fixed.</p></div></aside></div>
<div class="bottom-grid"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">LOCAL WORKSPACE DATA</span><h2>Concerns by service</h2></div><span class="muted small">@Model.Cases.Count cases</span></div><div class="service-bars">@foreach (var group in Model.Cases.GroupBy(c => c.Department).OrderByDescending(g => g.Count())) { <div class="service-row"><span>@CaseRules.Departments[group.Key]</span><meter min="0" max="@Math.Max(1, Model.Cases.Count)" value="@group.Count()">@group.Count()</meter><strong>@group.Count()</strong></div> } @if (!Model.Cases.Any()) { <p class="muted">Service trends will appear as you register cases.</p> }</div></section><section class="connection-card"><span class="eyebrow">CONNECTION STATUS</span><h2>AI and connections</h2><div class="connection-line"><span>Drafting assistance</span><span class="connection-state">@(Model.AiConnected ? "Configured" : "Template mode")</span></div><div class="connection-line"><span>IPGRS integration</span><span class="connection-state">Not connected</span></div><a href="/Readiness" class="text-link">See connection details →</a></section></div>
