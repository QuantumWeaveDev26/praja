@page
@model AiSettingsModel
@{ ViewData["Title"] = "OpenAI configuration"; }
<div class="page-heading"><div><span class="eyebrow">CONNECT YOUR LOCAL PILOT</span><h1>Configure OpenAI.</h1><p class="muted">Enter your API key here. Keep it out of chat, source code and screenshots.</p></div><a class="text-link" href="/Readiness">← Connections</a></div>
@if(Model.Notice is not null) { <div class="notice" role="status">@Model.Notice</div> }
<div class="intake-grid">
<section class="panel form-panel">
    <h2>Your connection</h2><p class="field-help">Credential: @(Model.HasCredential ? "present · never displayed" : "not configured"). Configuration alone does not verify service access.</p>
    <form method="post" asp-page="/AiSettings" asp-page-handler="Save" autocomplete="off">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <div class="field"><label asp-for="Input.ApiKey">API key</label><input asp-for="Input.ApiKey" type="password" maxlength="500" autocomplete="new-password" spellcheck="false" /><p class="field-help">Leave blank to retain the current key. Stored encrypted for this local workspace.</p></div>
        <div class="field"><label asp-for="Input.Model">Drafting and image/PDF OCR model</label><input asp-for="Input.Model" maxlength="100" required spellcheck="false" /><p class="field-help">Use a model available to your API project that supports chat, JSON output, image input and PDF file input. Defaults to gpt-4o-mini.</p></div>
        <label class="check-row"><input asp-for="Input.EnableSpeech" /> Enable speech transcription</label>
        <div class="field"><label asp-for="Input.SpeechModel">Speech model</label><input asp-for="Input.SpeechModel" maxlength="100" spellcheck="false" /><p class="field-help">Defaults to gpt-4o-mini-transcribe. Review Kannada transcripts against the original recording.</p></div>
        <div class="form-actions"><span class="field-help">Requests use OpenAI’s official HTTPS endpoints.</span><button class="button primary">Save configuration →</button></div>
    </form>
</section>
<aside><section class="panel help-card"><span class="eyebrow">VERIFY THE CONNECTION</span><h2>Try a sample draft.</h2><p class="field-help">The test sends a fictional water-supply complaint to OpenAI. It creates no case and may incur a small API charge.</p><form method="post" asp-page="/AiSettings" asp-page-handler="Test" data-busy><button class="button secondary" disabled="@(!Model.HasCredential)">Test drafting</button></form><p class="field-help">Citizen text, images or audio reach OpenAI only when their processing is submitted. Obtain consent and approved data-processing arrangements before using real complaints.</p></section>
<section class="panel help-card"><h2>Return to local processing.</h2><p class="field-help">Disable the provider to use local templates and text/PDF extraction. Image OCR and speech transcription will be unavailable.</p><form method="post" asp-page="/AiSettings" asp-page-handler="Disable"><button class="button secondary">Disable AI</button></form></section></aside>
</div>
