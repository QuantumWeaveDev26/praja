@page
@model GmailSettingsModel
@{ViewData["Title"]="Gmail connection";}
<a class="back-link" href="/Readiness">← Connections</a><div class="page-heading"><div><span class="eyebrow">EMAIL INTAKE</span><h1>Connect complaint email.</h1><p class="muted">Read selected complaint emails, preview their contents and save them for review.</p></div><span class="badge @(Model.Connected?"registered":"draft")">@(Model.Connected?"Connected":Model.Configured?"Ready to connect":"Not configured")</span></div>
@if(Model.Notice is not null){<div class="notice vertical" role="status">@Model.Notice</div>}
<div asp-validation-summary="All" class="validation" role="alert"></div>
@if(Model.Results is{}results){<section class="panel form-panel"><span class="eyebrow">EMAIL IMPORT COMPLETE</span><h2>@results.Count(r=>r.Created) new · @results.Count(r=>!r.Created) already saved</h2><p class="muted">No complaint was registered. Emails in Gmail were not changed.</p><ul class="plain-list">@foreach(var result in results){<li><a class="text-link" href="/Intake/Details/@result.Message.Id">Review @result.Message.ExternalId</a></li>}</ul><a class="button primary" href="/Intake">Open intake inbox</a></section>}
@if(Model.Notes.Count>0){<section class="panel form-panel"><h2>Email preview notes</h2><ul class="plain-list">@foreach(var note in Model.Notes){<li>@note</li>}</ul></section>}
@if(Model.Rows.Count>0){<section class="panel form-panel"><h2>@Model.Rows.Count emails to review</h2><div class="import-preview">@foreach(var row in Model.Rows){<article class="import-message"><div class="panel-heading"><h3>Email @row.Number</h3><span class="badge draft">@(row.ExistingId.HasValue?"Already saved":"New message")</span></div><blockquote class="original-text">@row.Message.OriginalText</blockquote><dl class="record-details"><dt>Source message ID</dt><dd>@row.Message.ExternalId</dd><dt>Language</dt><dd>@row.Message.Language</dd><dt>Suggested service</dt><dd>@CaseRules.Departments[row.Route.Department]</dd><dt>Demo category / issue</dt><dd>@PilotRoutingCatalog.CategoryLabel(row.Route.Category) / @PilotRoutingCatalog.IssueLabel(row.Route.Subcategory)</dd></dl><p class="field-help">Local keyword hints · Review before registration.</p>@if(row.Matches.Count>0){<p class="notice">Matching wording in @row.Matches.Count saved record(s). Compare before creating another case.</p>}</article>}</div><form method="post" asp-page-handler="Import" data-busy><input asp-for="PreviewToken" type="hidden"/><label class="check-row consent"><input asp-for="RetainPermission" required/><span>I reviewed the preview and have permission to retain these emails and source references in the local inbox.</span></label><button class="button primary">Confirm email import</button></form></section>}
<div class="intake-grid"><section class="panel form-panel"><h2>1. Save OAuth credentials</h2><p class="field-help">Client secret and Google tokens are encrypted for this officer and local workspace; never displayed.</p><form method="post" asp-page-handler="Save" autocomplete="off"><label asp-for="Input.ClientId">Google client ID</label><input asp-for="Input.ClientId" maxlength="200" required spellcheck="false"/><label asp-for="Input.ClientSecret">Google client secret</label><input asp-for="Input.ClientSecret" type="password" maxlength="300" autocomplete="new-password" spellcheck="false"/><p class="field-help">Leave blank to keep the secret for the same client ID. Keep it out of chat and screenshots.</p><label asp-for="Input.Mailbox">Mailbox to connect</label><input asp-for="Input.Mailbox" type="email" maxlength="200" required/><label asp-for="Input.LabelName">Complaint label in Gmail</label><input asp-for="Input.LabelName" maxlength="80" required/><p class="field-help">Create this custom label in Gmail and apply it only to complaint emails. Preview reads up to five matching messages; HTML bodies and up to three UTF-8 .txt or text-PDF attachments (64 KiB each) are extracted as text. Unsupported content requires manual review.</p><button class="button primary">Save Gmail configuration</button></form></section>
<aside><section class="panel help-card"><h2>Google callback URL</h2><label for="gmail-callback">Authorized redirect URI · Copy exactly</label><textarea id="gmail-callback" readonly rows="3" spellcheck="false">@Model.Callback</textarea><p class="field-help">Add this under Authorized redirect URIs for your Google Web application client. Leave JavaScript origins blank. Sign in to Praja on this same host and port.</p></section>
<section class="panel help-card"><h2>2. Connect the mailbox</h2><p class="field-help">Choose @Model.Input.Mailbox in Google and grant read-only Gmail access. Praja verifies that the returned account matches this address.</p><form method="post" asp-page-handler="Connect"><label class="check-row consent"><input asp-for="ConnectPermission" required/><span>I authorise read-only Gmail connection for this mailbox. The requested Gmail permission can read mail; Praja fetches only the complaint label.</span></label><button class="button secondary" disabled="@(!Model.Configured)">Connect Gmail</button></form></section>
<section class="panel help-card"><h2>3. Preview complaint emails</h2><p class="field-help">Preview reads the labelled emails into this page. Confirm import separately to retain them; AI is not contacted.</p><form method="post" asp-page-handler="Preview" data-busy><button class="button secondary" disabled="@(!Model.Connected)">Preview Gmail messages</button></form></section>
<section class="panel help-card"><h2>Stop mailbox access</h2><form method="post" asp-page-handler="Disconnect"><button class="button secondary">Disconnect Gmail</button></form></section></aside></div>
